# ============================================================================
# CONMINGO — Variables de entorno del backend
# Desarrollo: copiar a backend/.env | Producción (Render): Environment del servicio.
# NUNCA subir el .env real al repositorio.
# ============================================================================

# ---- Servidor ----
PORT=4000

# ---- Supabase (Project Settings → API) ----
SUPABASE_URL=https://<ref-proyecto>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ---- PostgreSQL (LOTE O: usar el CONNECTION POOLER, puerto 6543) ----
# Formato del pooler (transaction mode), visible en Supabase → Connect:
# DATABASE_URL=postgresql://postgres.<ref-proyecto>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# SSL:
# - En local con Postgres propio:    DATABASE_SSL=false
# - En producción (Supabase/Render): dejar sin DATABASE_SSL (usa rejectUnauthorized:false)
#   o idealmente definir PGSSLCERT con la CA (ruta al archivo o el PEM completo).
DATABASE_SSL=false
PGSSLCERT=

# Tuning del pool (LOTE O, opcionales — defaults entre paréntesis)
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000

# ---- Respaldo programado (LOTE O: GitHub Action → endpoint /api/superadmin/respaldo-programado) ----
# Misma valeur que el secret BACKUP_SECRET del repo; sin ella el endpoint rechaza todo.
BACKUP_SECRET=
